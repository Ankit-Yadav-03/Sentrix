# Sentrix — Environment Variables

# ── PostgreSQL ─────────────────────────────────────────────────────────────
DATABASE_URL=your_postgresql_connection_string_here

# ── Ollama LLM ─────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=your_ollama_base_url_here
OLLAMA_MODEL=your_ollama_model_here

# ── Classifier Model ───────────────────────────────────────────────────────
# Path to fine-tuned distilBERT model directory.
# Leave blank to use rule-based fallback (v0 default).
CLASSIFIER_MODEL_PATH=your_classifier_model_path_here

# ── Frontend API URL ───────────────────────────────────────────────────────
# URL the Next.js frontend calls for API requests.
NEXT_PUBLIC_API_URL=your_frontend_api_url_here